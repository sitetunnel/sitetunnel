{
  "manifest_version": 3,
  "name": "SiteTunnel — Single Site VPN Switcher",
  "short_name": "SiteTunnel",
  "version": "1.2.0",
  "description": "Route specific websites through secure cloud tunnel with one click. Clean, instant, and minimalist.",
  "permissions": [
    "proxy",
    "storage",
    "tabs"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SiteTunnel"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
