{
  "manifest_version": 3,
  "name": "SiteTunnel — Single Site VPN Switcher",
  "short_name": "SiteTunnel",
  "version": "1.4.1",
  "description": "Route specific websites through secure cloud tunnels & Surfshark locations with one click. Clean, instant, and split-tunnel.",
  "permissions": [
    "proxy",
    "storage",
    "tabs",
    "webRequest",
    "webRequestAuthProvider"
  ],
  "host_permissions": [
    "https://api.surfshark.com/*",
    "https://*.prod.surfshark.com/*",
    "https://api.country.is/*",
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SiteTunnel"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
